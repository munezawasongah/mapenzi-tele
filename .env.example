# ── DATABASE (Railway provides this automatically) ─────
DATABASE_URL=postgresql://user:password@host:5432/mapenzitele

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_string_min_32_chars

# ── APP ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-app.up.railway.app
CLIENT_URL=https://your-app.up.railway.app

# ── UPLOADS ────────────────────────────────────────────
# Railway's filesystem is EPHEMERAL — photos are lost on every redeploy unless
# you attach a Volume and point this at its mount path (e.g. /data/uploads)
UPLOAD_DIR=/data/uploads
